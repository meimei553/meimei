# 智谱开放平台 API Key（在 https://open.bigmodel.cn 控制台创建）
# 复制本文件为 .env 后填入真实 Key；.env 已被 .gitignore 排除，不会提交
ZAI_API_KEY=在这里填入你的APIKey

# 智谱 API 地址（一般不用改）
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 分析与润色使用的模型（glm-4.7-flash 免费，适合开发测试）
MODEL_ANALYZE=glm-4.7-flash
MODEL_POLISH=glm-4.7-flash

# 演示模式：auto=没有 Key 时自动返回示例数据；on=强制演示；off=关闭
DEMO_MODE=auto

# SQLite 数据库文件路径
DATABASE_PATH=meimei.db
