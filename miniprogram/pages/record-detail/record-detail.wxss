.comfort {
  background: #fdf6ec;
  color: #7a5c2e;
}

.emotion-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.emotion-name {
  font-weight: bold;
  min-width: 120rpx;
}

.emotion-percent {
  color: #4a90d9;
}

.polish-version {
  margin-bottom: 20rpx;
}

.polish-tone {
  color: #4a90d9;
  margin-bottom: 8rpx;
}

.chat-row {
  display: flex;
  margin-bottom: 16rpx;
}

.chat-row.user {
  justify-content: flex-end;
}

.chat-bubble {
  max-width: 80%;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #f0f0f0;
}

.chat-row.user .chat-bubble {
  background: #d6e9fa;
}

.chat-input-bar {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  position: sticky;
  bottom: 0;
}

.chat-input {
  flex: 1;
  background: #f5f5f5;
  border-radius: 30rpx;
  padding: 16rpx 24rpx;
}

.send-btn {
  background: #4a90d9;
  color: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
  padding: 0 32rpx;
}
