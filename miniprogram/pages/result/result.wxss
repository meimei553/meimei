.comfort {
  background: #fdf6ec;
  color: #7a5c2e;
}

.emotion-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.emotion-name {
  font-weight: bold;
  min-width: 120rpx;
}

.emotion-percent {
  color: #4a90d9;
}

.key-sentence {
  margin-bottom: 12rpx;
}

.question {
  color: #4a90d9;
  margin-bottom: 16rpx;
  padding: 16rpx;
  background: #eaf3fc;
  border-radius: 12rpx;
}

.disclaimer {
  text-align: center;
  margin: 24rpx;
}

.hint {
  margin-top: 16rpx;
}
